<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GutOralAxis.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Gut-Oral Axis Analysis Platform">
    <!-- The transparent custom title bar exposes the system acrylic backdrop. -->
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="48"
            Background="Transparent">
            <StackPanel
                Margin="12,0,0,0"
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Spacing="10">
                <Image
                    Width="27"
                    Height="27"
                    Source="Assets/AppIcon.png"
                    Stretch="Uniform" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Text="Gut-Oral Axis Analysis Platform" />
            </StackPanel>
            <Border
                Height="1"
                VerticalAlignment="Bottom"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                IsHitTestVisible="False" />
        </Grid>

        <WebView2 x:Name="WebView" Grid.Row="1" />
        <Grid
            x:Name="StartupOverlay"
            Grid.Row="1"
            Background="{ThemeResource LayerFillColorDefaultBrush}">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16"
                MaxWidth="560">
                <ProgressRing x:Name="StartupProgress" IsActive="True" Width="42" Height="42" />
                <TextBlock
                    Text="正在启动本地分析系统"
                    Style="{StaticResource TitleTextBlockStyle}"
                    HorizontalAlignment="Center" />
                <TextBlock
                    x:Name="StartupStatus"
                    Text="正在准备数据库和 AI Engine……"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    TextAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
