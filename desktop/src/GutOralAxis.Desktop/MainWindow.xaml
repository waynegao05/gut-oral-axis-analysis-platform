<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GutOralAxis.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Gut-Oral Axis Analysis Platform">
    <Grid Background="#F5F2EA">
        <WebView2 x:Name="WebView" />
        <Grid x:Name="StartupOverlay" Background="#F5F2EA">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16"
                MaxWidth="560">
                <ProgressRing x:Name="StartupProgress" IsActive="True" Width="42" Height="42" />
                <TextBlock
                    Text="正在启动本地分析系统"
                    FontSize="24"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center" />
                <TextBlock
                    x:Name="StartupStatus"
                    Text="正在准备数据库和 AI Engine……"
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    Foreground="#526267" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
